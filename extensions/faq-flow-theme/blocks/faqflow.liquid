<div
  class="faqflow"
  data-faqflow
  data-api-url="/apps/faqflow"
  data-show-search="{{ block.settings.show_search }}"
  data-show-categories="{{ block.settings.show_categories }}"
  data-default-category="{{ block.settings.default_category | escape }}"
  data-show-groups="{{ block.settings.show_groups }}"
  data-default-group="{{ block.settings.default_group | escape }}"
  data-category-style="{{ block.settings.category_style }}"
  data-layout-style="{{ block.settings.layout_style }}"
  data-accordion-style="{{ block.settings.accordion_style }}"
  data-product-id="{% if product %}{{ product.id }}{% endif %}"
  data-collection-id="{% if collection %}{{ collection.id }}{% endif %}"
  style="
    --faqflow-max-width: {{ block.settings.content_width }}px;
    --faqflow-heading-align: {{ block.settings.heading_alignment }};
    --faqflow-accent-color: {{ block.settings.accent_color }};
    --faqflow-question-color: {{ block.settings.question_color }};
    --faqflow-answer-color: {{ block.settings.answer_color }};
    --faqflow-border-width: {{ block.settings.border_width }}px;
    --faqflow-border-radius: {{ block.settings.border_radius }}px;
  "
>
  {% if block.settings.heading != blank %}
    <div class="faqflow__header">
      <h2 class="faqflow__heading">
        {{ block.settings.heading | escape }}
      </h2>
    </div>
  {% endif %}

  {% if block.settings.show_search %}
    <div class="faqflow__search">
      <label class="faqflow__search-label" for="faqflow-search-{{ block.id }}">
        {{ block.settings.search_label | escape }}
      </label>

      <div class="faqflow__search-control">
        <input
          id="faqflow-search-{{ block.id }}"
          class="faqflow__search-input"
          type="search"
          placeholder="{{ block.settings.search_placeholder | escape }}"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="faqflow-search-meta-{{ block.id }}"
        >

        <button
          class="faqflow__search-clear"
          type="button"
          aria-label="{{ block.settings.clear_search_label | escape }}"
          hidden
        >
          ×
        </button>
      </div>

      <div
        id="faqflow-search-meta-{{ block.id }}"
        class="faqflow__search-meta"
        aria-live="polite"
      ></div>
    </div>
  {% endif %}

  <div
    class="faqflow__groups"
    data-faqflow-groups
    hidden
  ></div>

  <div
    class="faqflow__categories"
    data-faqflow-categories
    hidden
  ></div>

  <div
    class="faqflow__status"
    data-faqflow-status
    aria-live="polite"
  >
    {{ block.settings.loading_text | escape }}
  </div>

  <div
    class="faqflow__list"
    data-faqflow-list
  ></div>

  <script type="application/ld+json" data-faqflow-jsonld></script>
</div>

{% schema %}
{
  "name": "FAQFlow FAQs",
  "target": "section",
  "stylesheet": "faqflow.css",
  "javascript": "faqflow.js",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search FAQs"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search questions and answers..."
    },
    {
      "type": "text",
      "id": "clear_search_label",
      "label": "Clear search label",
      "default": "Clear search"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Loading FAQs..."
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Show categories",
      "default": true
    },
    {
      "type": "select",
      "id": "category_style",
      "label": "Category style",
      "default": "pills",
      "options": [
        {
          "value": "pills",
          "label": "Pills"
        },
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "tabs",
          "label": "Tabs"
        }
      ]
    },
    {
      "type": "text",
      "id": "default_category",
      "label": "Default category slug",
      "info": "Optional. Leave blank to show all categories."
    },
    {
      "type": "checkbox",
      "id": "show_groups",
      "label": "Show groups",
      "default": false
    },
    {
      "type": "text",
      "id": "default_group",
      "label": "Default group slug",
      "info": "Optional. Leave blank to show all groups."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "FAQ layout",
      "default": "accordion",
      "options": [
        {
          "value": "accordion",
          "label": "Accordion"
        },
        {
          "value": "two_column",
          "label": "Two columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "accordion_style",
      "label": "FAQ style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "type": "header",
      "content": "Visual customization"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "default": "1200",
      "options": [
        {
          "value": "640",
          "label": "640px"
        },
        {
          "value": "800",
          "label": "800px"
        },
        {
          "value": "1000",
          "label": "1000px"
        },
        {
          "value": "1200",
          "label": "1200px"
        },
        {
          "value": "1400",
          "label": "1400px"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question and heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ]
}
{% endschema %}
